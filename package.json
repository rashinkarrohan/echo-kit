{
  "name": "echo-kit",
  "version": "0.0.0",
  "description": "A receipt you can check for a spoken conversation: every fact quotes its words and links to the audio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rashinkarrohan/echo-kit.git"
  },
  "homepage": "https://github.com/rashinkarrohan/echo-kit#readme",
  "bugs": {
    "url": "https://github.com/rashinkarrohan/echo-kit/issues"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "evals": "pnpm --filter @echo/evals start",
    "dev:care": "pnpm --filter echo-care dev",
    "dev:cover": "pnpm --filter echo-cover dev",
    "ci:check-gitignore": "node scripts/check-gitignore.mjs",
    "e2e": "pnpm --filter @echo/ui e2e",
    "check:schemas": "pnpm --filter @echo/evals validate:schemas",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
